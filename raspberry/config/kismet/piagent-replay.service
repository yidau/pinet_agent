[Unit]
Description=PocketNet bounded offline Kismet replay controller
After=piagent-kismet.service

[Service]
User=piagent-kismet
Group=piagent-kismet
SupplementaryGroups=piagent-captures
WorkingDirectory=/usr/local/lib/piagent-sources
ExecStart=/usr/bin/python3 -m raspberry.mcp_server.source_control controller
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/piagent-kismet
UMask=0077
Restart=on-failure
