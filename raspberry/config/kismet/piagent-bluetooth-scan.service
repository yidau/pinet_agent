[Unit]
Description=PocketNet operator-started Linux Bluetooth scan (two minutes)
After=bluetooth.service piagent-kismet.service
Requisite=bluetooth.service piagent-kismet.service
ConditionPathExists=!/etc/piagent-sources/bluetooth-conflict

[Service]
User=piagent-bt-scan
Group=piagent-bt-scan
SupplementaryGroups=kismet
WorkingDirectory=/usr/local/lib/piagent-sources
RuntimeDirectory=piagent-bt-scan
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/python3 -m raspberry.mcp_server.source_control bt-prepare
ExecStart=/usr/bin/python3 -m raspberry.mcp_server.source_control bt-run
ExecStopPost=-+/usr/bin/python3 -m raspberry.mcp_server.source_control bt-retire
RuntimeMaxSec=120
TimeoutStopSec=4
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
