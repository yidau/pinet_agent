[Unit]
Description=PocketNet local Kismet observation service
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
User=piagent-kismet
Group=piagent-kismet
RuntimeDirectory=piagent-kismet
RuntimeDirectoryMode=0700
Environment=HOME=/run/piagent-kismet
WorkingDirectory=/run/piagent-kismet
ExecStartPre=/usr/bin/mkdir -p /run/piagent-kismet/.kismet
ExecStart=/usr/bin/kismet --no-ncurses --no-line-wrap --no-logging --homedir /run/piagent-kismet --override /etc/kismet/piagent.conf
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
