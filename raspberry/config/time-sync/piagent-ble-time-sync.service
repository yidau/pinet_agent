[Unit]
Description=PiAgent BLE time synchronization
Requires=bluetooth.service piagent-clock.socket
After=bluetooth.service piagent-clock.socket
StartLimitIntervalSec=0

[Service]
User=piagent-ble
WorkingDirectory=/opt/piagent-time-sync
ExecStart=/opt/piagent-time-sync/.venv/bin/python -B -m raspberry.time_sync.ble_server --peer-file /etc/piagent-time-sync/peer
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
