[Unit]
Description=PocketNet telemetry service
After=piagent-hotspot.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=piagent-enrollment piagent-control
EnvironmentFile=-/run/piagent-kismet/client.env
EnvironmentFile=-/etc/piagent-telemetry/service.env
LoadCredential=server.key:/etc/piagent-https/server.key
LoadCredential=server.pem:/etc/piagent-https/server.pem
RuntimeDirectory=piagent-telemetry
RuntimeDirectoryMode=0755
StateDirectory=pocketnet-highrisk
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/piagent-telemetry
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
