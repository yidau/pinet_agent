[Unit]
Description=PocketNet Wi-Fi hotspot
BindsTo=sys-subsystem-net-devices-wlan0.device
After=sys-subsystem-net-devices-wlan0.device
RequiresMountsFor=/var/lib/piagent-enrollment

[Service]
ExecStartPre=/usr/bin/python3 -I -B /opt/pocketnet/current/raspberry/config/runtime/prepare-hotspot.py
ExecStartPre=/usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/sbin/ip link set wlan0 up
ExecStartPre=/usr/sbin/ip address replace 192.168.4.1/24 dev wlan0
ExecStart=/usr/sbin/hostapd /etc/hostapd/piagent.conf
Restart=on-failure
RestartSec=3s
UMask=0077

[Install]
WantedBy=multi-user.target
